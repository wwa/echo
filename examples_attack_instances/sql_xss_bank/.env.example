# Vulnerable Fake Bank Configuration
# Copy this file to .env and adjust settings as needed

# ===========================
# SERVER CONFIGURATION
# ===========================

# Flask server host (use 0.0.0.0 to allow external connections)
HOST=127.0.0.1

# Flask server port
PORT=8200

# Flask debug mode (true/false)
DEBUG=true

# ===========================
# DATABASE CONFIGURATION
# ===========================

# SQLite database file path
DB_PATH=bank.db

# ===========================
# SECURITY CONFIGURATION
# ===========================

# Flask secret key (intentionally weak for demonstration)
SECRET_KEY=insecure_secret_key_12345

# Session cookie name
SESSION_COOKIE_NAME=bank_session

# Session timeout in seconds (default: 3600 = 1 hour)
SESSION_TIMEOUT=3600

# ===========================
# APPLICATION SETTINGS
# ===========================

# Number of recent transactions to display on dashboard
MAX_TRANSACTIONS=10

# Number of recent messages to display
MAX_MESSAGES=5

# Enable/disable detailed error messages (for SQL injection demonstration)
SHOW_DETAILED_ERRORS=true

# ===========================
# ATTACK DEMONSTRATION
# ===========================

# Show vulnerability hints in UI (for educational purposes)
SHOW_VULNERABILITY_HINTS=true

# Enable request logging for testing
ENABLE_REQUEST_LOGGING=true

# Log file path
LOG_FILE=bank_access.log

# ===========================
# RATE LIMITING (Intentionally disabled for testing)
# ===========================

# Enable rate limiting (false = disabled for easy testing)
ENABLE_RATE_LIMITING=false

# Max login attempts before lockout
MAX_LOGIN_ATTEMPTS=1000

# Lockout duration in seconds
LOCKOUT_DURATION=300
